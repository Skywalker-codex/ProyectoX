@using System.Diagnostics.Eventing.Reader
@using System.Security.Claims;
@model IEnumerable<ProyectoX.Models.LogConJuegoViewModel>
@{
    ViewData["Title"] = "Logs";

    var estados = ViewBag.Estados as List<ProyectoX.Models.EstadoJuego>;
}

<h1>Logs</h1>

<div>
    <main role="main" class="pb-3">
        @if(User.Identity.IsAuthenticated)
        {
            var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
            
            @if(Model == null || !Model.Any())
            {
                <p>Este usuario no ha registrado juegos</p>
            }
            else
            {
                <div>Lista de juegos: </div>
                <div>
                    @foreach(var log in Model)
                    {
                        <div>
                            <a asp-controller="Games" asp-action="Details" asp-route-id="@log.Juego.Id">
                                <img src="https:@log.Juego.Cover.Value.Url.Replace("t_thumb", "t_cover_big")" alt="@log.Juego.Name" />
                            </a>
                            @if((int.TryParse(userId, out var userIdInt)) && log.Log.UserId == userIdInt)
                            {
                                <h2>Editar log</h2>
                                <form asp-controller="Logs" asp-action="Edit" method="post" asp-route-id="@log.Log.Id">
                                    <input type="hidden" name="id" value="@log.Log.Id" />

                                    <select id="gameState" name="stateId" required>
                                        @foreach (var state in estados)
                                        {
                                            <option value="@state.Id" selected="@(state.Id == log.Log.StateId ? "selected" : null)">@state.Nombre</option>
                                        }
                                    </select>

                                    <textarea name="review">@log.Log.Review</textarea>

                                    <input type="number" name="rating" min="0" max="10" value="@log.Log.Rating" />

                                    <button type="submit">Guardar cambios</button>
                                </form>
                            }
                            
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <p>No tienes cuenta? </p> <a asp-controller="Auth" asp-action="Register" class="btn btn-primary">Regístrate</a>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Inicia sesión si ya estás registrado.</a>
        }
    </main>
</div>
