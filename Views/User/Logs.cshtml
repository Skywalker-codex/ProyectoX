@model IEnumerable<ProyectoX.Models.Log>
@{
    ViewData["Title"] = "Logs";
}

<h1>Logs</h1>

<div>
    <main role="main" class="pb-3">
        @if(User.Identity.IsAuthenticated)
        {
            <div>Lista de juegos: </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Juego (ID)</th>
                        <th>Estado</th>
                        <th>Valoración</th>
                        <th>Reseña</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.LogDate.ToString("dd/MM/yyyy")</td>
                            <td>@log.GameId</td>
                            <td>@log.GameState</td>
                            <td>@log.Rating</td>
                            <td>@log.Review</td>
                        </tr>
                    }
                </tbody>
            </table>

        }
        else
        {
            <p>No tienes cuenta? </p> <a asp-controller="Auth" asp-action="Register" class="btn btn-primary">Regístrate</a>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">Inicia sesión si ya estás registrado.</a>
        }
    </main>
</div>
