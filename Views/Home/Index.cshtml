@model IEnumerable<IGDB.Models.Game>
@{
    ViewData["Title"] = "Home Page";
}

<head>
    <link rel="stylesheet" href="~/css/homeIndex.css" asp-append-version="true"/>
</head>

<div id="inicio">

    <div class="d-flex justify-content-center" id="contenedor-imagenes">
        <div class="imagen-inclinada-container">
            <img class="imagen-inclinada" src="~/images/Astro.jpg"/>
        </div>
        <div class="imagen-inclinada-container">
            <img class="imagen-inclinada" src="~/images/GOT.jpg"/>
        </div>
        <div class="imagen-inclinada-container">
            <img class="imagen-inclinada" src="~/images/Bananza.jpg"/>
        </div>
        <div class="imagen-inclinada-container">
            <img class="imagen-inclinada" src="~/images/Cyberpunk.png"/>
        </div>
    </div>

    

    <div class="d-flex flex-column justify-content-center align-items-center text-center" id="title">
        <h1 id="titulo" class="display-4">Proyecto X</h1>
        <div class="d-grid gap-2 mx-auto col-6" id="auth-buttons">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary border border-light border-2" role="button">Iniciar sesión</a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-primary border border-light border-2" role="button" >Registrarse</a>
        </div>
    </div>
    
</div>

