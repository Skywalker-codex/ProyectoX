<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoX</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoX.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ProyectoX</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li>
                            <a class="nav-link text-dark" asp-area="" asp-controller="Games" asp-action="Index">Juegos</a>
                        </li>
                        @if(User.Identity.IsAuthenticated)
                        {
                            <li>
                                <a class ="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Profile">Perfil</a>
                            </li>
                            <li>
                                <a class ="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Index">Usuarios</a>
                            </li> 
                        }
                    </ul>
                    <div class="buscador-container">
                        <input type="text" id="buscador-global" placeholder="Buscar"/>
                        <div id="lista-resultados"></div>
                    </div>
                </div>
            </div>
            @if (User.Identity.IsAuthenticated)
            {
                <p> @User.Identity.Name</p>
                <a asp-controller="Auth" asp-action="Logout">Cerrar sesión</a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login">Iniciar sesión</a>
            }
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ProyectoX - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        const input = document.getElementById("buscador-global");
        const lista = document.getElementById("lista-resultados");

        input.addEventListener("input", async (event) =>{
            const texto = input.value.trim();

            if(texto.length >= 3)
            {
                try{
                    const response = await fetch(`/Games/Search?query=${texto}`);

                    if(!response.ok){
                        throw new Error('Error HTTP: ' + response.status);
                    }

                    const data = await response.json();

                    lista.innerHTML = data.map(juego => `
                        <a href="/Games/Details/${juego.id}">
                            <p>${juego.name}</p>
                        </a>
                    `).join('');
                }catch(error){
                    console.error(error);
                }
            } else if (texto.length < 3)
            {
                lista.innerHTML = "";
            }
        })
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
